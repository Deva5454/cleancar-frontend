# CleanCar 360° — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env/.env.local.

# ── WhatsApp OTP delivery (Interakt) ─────────────────────────────────────────
# STATUS: Dummy value below. Real OTP delivery will NOT work until both of
# these are done:
#   1. Get a real Interakt API key from https://app.interakt.ai (Settings ->
#      API Keys), base64-encoded as the dashboard provides it.
#   2. Register an "Authentication"-category WhatsApp template named
#      exactly "otp_verification" in Meta Business Manager and get it
#      approved by Meta - authentication templates have stricter formatting
#      rules than regular message templates, so a normal template will be
#      rejected. See src/app/services/whatsappService.ts for the real,
#      already-built integration this key plugs into - it gracefully falls
#      back to showing the OTP on screen if this key is missing/invalid, so
#      nothing breaks while waiting on the real credential.
VITE_INTERAKT_API_KEY=dummy_interakt_key_replace_with_real_value

# ── Backend API (if/when a real backend is deployed) ─────────────────────────
VITE_API_URL=https://your-backend-url.example.com
VITE_WS_URL=wss://your-backend-url.example.com

# ── Supabase (if used for this deployment) ───────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=dummy_supabase_anon_key_replace_with_real_value
